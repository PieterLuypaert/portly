#!/usr/bin/env python3
"""portly from a checkout of its repo: runs the code in src/portly next to
this file, also through a symlink such as ~/.local/bin/portly. A release
ships portly as one file instead, built from src/portly (see the README)."""
import os
import shlex
import sys

RELEASE = "https://github.com/PieterLuypaert/portly/releases/latest/download/portly"
SOURCE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "src")

if not os.path.isdir(os.path.join(SOURCE, "portly")):
    here = shlex.quote(sys.argv[0])
    sys.exit("This file runs portly from a checkout of its repo, and finds no src/portly next to it.\n"
             f"To install portly, download the release instead:\n  curl -fsSL {RELEASE} -o {here} && chmod +x {here}")

sys.path.insert(0, SOURCE)

from portly.cli import main

sys.exit(main())
