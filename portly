HOME = os.path.expanduser("~")

# Executables that run a script: the script names the process, not the binary.
# macOS runs python3 as .../Python.app/Contents/MacOS/Python.
INTERPRETER = re.compile(r"node|bun|deno|python[\d.]*|ruby|php")


@dataclass
class Place:
    repo: str  # folder name of the main checkout
    sub: str  # folder inside the checkout, "" at its root
    branch: str
    is_worktree: bool
    top: str = ""  # root of the checkout
    common: str = ""  # git common dir, where wt keeps its registry


@dataclass
class Stack:
    """A worktree stack that wt started, read from its registry entry."""
    name: str  # wt's project name: shop in the compose project shop-wt1
    index: int
    path: str  # the worktree
    ports: Dict[str, int]  # role (web, api, gcs, ...) to port
    registry: str = ""  # the folder with wt's entries, pid files and logs
    db: str = ""  # the worktree's database, "" without one

    def role_of(self, port: int) -> str:
        return next((role for role, value in self.ports.items() if value == port), "")

    def pid_file(self, role: str) -> str:
        """wt writes it when it starts the role's server and removes it when it stops it."""
        return os.path.join(self.registry, f"{self.index}-{role}.pid")

    def log_file(self, role: str) -> str:
        return os.path.join(self.registry, "logs", f"{self.index}-{role}.log")


@dataclass
class Restart:
    """How to start a server again: the command that started it, in its folder."""
    argv: List[str]
    cwd: str
    pids: List[int]  # the launcher first, then everything under it: stopped before the start
    log: str  # the new output is appended here
    pidfile: str = ""  # wt's pid file for this server: it gets the new pid, so wt down still finds it
    terminal: str = ""  # the tty it ran in; after the restart it runs in the background
    env: Dict[str, str] = field(default_factory=dict)  # set on top of portly's own environment


@dataclass
class Container:
    name: str
    image: str
    status: str  # docker's "Up 6 days"
    project: str  # compose project, "" outside compose
    service: str
    folder: str  # compose working dir
    inner: Dict[int, int] = field(default_factory=dict)  # host port to container port


@dataclass
class Listener:
    port: int
    pid: int
    command: str  # lsof's short name, the label of last resort
    ppid: int = 0
    elapsed: str = ""  # ps etime: [[dd-]hh:]mm:ss
    args: str = ""
    cwd: str = ""
    place: Optional[Place] = None
    container: Optional[Container] = None
    stack: Optional[Stack] = None
    addresses: List[str] = field(default_factory=list)  # bound to, such as 127.0.0.1 or *
    tty: str = ""  # ps tty: ?? on macOS and ? on Linux without a terminal
    rss_kb: int = 0
    cpu: str = ""
    others: List["Listener"] = field(default_factory=list)  # other servers on this port, beside this row
    is_down: bool = False  # a wt stack's port that nothing listens on: no process, pid 0
    last_output: List[str] = field(default_factory=list)  # a down port's last lines in wt's log
    # Only read for the detail views (deep=True):
    parent: str = ""  # short command line of the parent
    log: str = ""  # the file its output goes to: stdout, or an open .log
    stdout: str = ""  # stdout when that is a file
    connections: int = -1
    restart: Optional[Restart] = None
    restart_problem: str = ""  # why it cannot be restarted


def run(cmd: List[str]) -> str:
    """Stdout of cmd. lsof exits 1 on any missing pid and git outside a repo,
    so the exit code is no sign of failure here; a missing tool gives "".
    Bytes that are no UTF-8, such as in any process's arguments, become �."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=10).stdout
    except FileNotFoundError:
        return ""


def port_of(address: str) -> Optional[int]:
    """The port of an lsof address such as 127.0.0.1:8000, *:80 or [::1]:3000."""
    port = address.rpartition(":")[2]
    return int(port) if port.isdigit() else None


def parse_lsof(text: str) -> List[Listener]:
    """One Listener per port and pid from `lsof -F pcn` output; a process that
    listens on both IPv4 and IPv6 is counted once."""
    found = {}
    pid, command = 0, ""
    for line in text.splitlines():
        field, value = line[:1], line[1:]
        if field == "p":
            pid = int(value)
        elif field == "c":
            command = value
        elif field == "n":
            port = port_of(value)
            if port is not None:
                item = found.setdefault((port, pid), Listener(port, pid, command))
                address = value.rpartition(":")[0]
                if address not in item.addresses:
                    item.addresses.append(address)
    return list(found.values())


def main_checkout(common: str) -> str:
    """The main checkout of a git common dir: the folder that holds .git."""
    return os.path.dirname(common) if os.path.basename(common) == ".git" else common


def place_of(cwd: str) -> Optional[Place]:
    if not cwd or cwd == "/":
        return None
    out = run([
        "git", "-C", cwd, "rev-parse", "--path-format=absolute",
        "--show-toplevel", "--git-common-dir", "--abbrev-ref", "HEAD",
    ]).splitlines()
    if len(out) != 3:
        return None
    top, common, branch = os.path.realpath(out[0]), os.path.realpath(out[1]), out[2]
    main = main_checkout(common)
    sub = os.path.relpath(os.path.realpath(cwd), top)
    repo = os.path.basename(main)
    return Place(
        repo=repo[:-4] if repo.endswith(".git") else repo,
        sub="" if sub == "." else sub,
        branch=branch,
        is_worktree=top != main,
        top=top,
        common=common,
    )


# The fields of a wt registry entry that hold no port, as wt itself reads them.
REGISTRY_FIELDS = {"branch", "path", "ports", "db", "pr", "here"}


def read_stacks(common: str) -> List[Stack]:
    """wt's registry next to a git dir: one <common>/<name>-worktrees/<n>.env
    per worktree, with REG_PATH and its ports: REG_PORTS=web=20110 api=20111,
    or a REG_<ROLE> line per port from older wt engines. A byte that is no
    UTF-8, such as in a branch name, becomes �, as in run()."""
    stacks = []
    for entry in sorted(glob.glob(os.path.join(common, "*-worktrees", "*.env"))):
        index = os.path.basename(entry)[: -len(".env")]
        if not index.isdecimal():
            continue
        values = {}
        with open(entry, encoding="utf-8", errors="replace") as lines:
            for line in lines:
                key, sep, value = line.strip().partition("=")
                if sep and key.startswith("REG_"):
                    values[key[4:].lower()] = value.strip('"')
        if values.get("ports"):
            pairs = (pair.partition("=") for pair in values["ports"].split())
            ports = {role: int(port) for role, _, port in pairs if port.isdecimal()}
        else:
            ports = {role: int(value) for role, value in values.items()
                     if value.isdecimal() and role not in REGISTRY_FIELDS}
        name = os.path.basename(os.path.dirname(entry))[: -len("-worktrees")]
        stacks.append(Stack(name, int(index), values.get("path", ""), ports, os.path.dirname(entry),
                            values.get("db", "")))
    return stacks


class Lookup:
    """Places and registries found during one scan: many ports share a folder."""

    def __init__(self):
        self.places: Dict[str, Optional[Place]] = {}
        self.stacks: Dict[str, List[Stack]] = {}

    def place(self, path: str) -> Optional[Place]:
        if path not in self.places:
            self.places[path] = place_of(path)
        return self.places[path]

    def stacks_of(self, place: Place) -> List[Stack]:
        if place.common not in self.stacks:
            self.stacks[place.common] = read_stacks(place.common)
        return self.stacks[place.common]

    def stack_at(self, place: Place) -> Optional[Stack]:
        return next((stack for stack in self.stacks_of(place)
                     if os.path.realpath(stack.path) == place.top), None)

    def container_home(self, container: "Container") -> Tuple[Optional[Place], Optional[Stack]]:
        """The checkout a container belongs to: its wt worktree when wt started
        it, else the checkout of its compose folder."""
        home = self.place(container.folder) if container.folder else None
        match = re.fullmatch(r"(.+)-wt(\d+)", container.project)
        if home and match:
            for stack in self.stacks_of(home):
                if (stack.name, stack.index) == (match.group(1), int(match.group(2))) and stack.path:
                    return self.place(stack.path), stack
        return home, None


def add_process_info(listeners: List[Listener], lookup: Lookup) -> None:
    """Fill in parent, age, command line, working folder and place."""
    pids = ",".join(sorted({str(item.pid) for item in listeners}))
    info = {}
    for line in run(["ps", "-o", "pid=,ppid=,etime=,tty=,rss=,%cpu=,command=", "-p", pids]).splitlines():
        parts = line.split(None, 6)
        if len(parts) == 7:
            info[int(parts[0])] = parts[1:]
    cwds, pid = {}, 0
    for line in run(["lsof", "-a", "-p", pids, "-d", "cwd", "-Fpn"]).splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n"):
            cwds[pid] = line[1:]
    for item in listeners:
        if item.pid in info:
            ppid, item.elapsed, item.tty, rss, item.cpu, item.args = info[item.pid]
            item.ppid, item.rss_kb = int(ppid), int(rss) if rss.isdigit() else 0
        item.cwd = cwds.get(item.pid, "")
        item.place = lookup.place(item.cwd)


DOCKER_FORMAT = "\t".join([
    "{{.Names}}", "{{.Image}}", "{{.Ports}}", "{{.Status}}",
    '{{.Label "com.docker.compose.project"}}',
    '{{.Label "com.docker.compose.service"}}',
    '{{.Label "com.docker.compose.project.working_dir"}}',
])


def parse_docker(text: str) -> Dict[int, Container]:
    """Containers by the host ports they publish, from `docker ps` in DOCKER_FORMAT."""
    by_port = {}
    for line in text.splitlines():
        fields = line.split("\t")
        if len(fields) != 7:
            continue
        name, image, ports, status, project, service, folder = fields
        container = Container(name, image, status, project, service, folder)
        for match in re.finditer(r":(\d+)(?:-(\d+))?->(\d+)(?:-\d+)?/tcp", ports):
            first, inner = int(match.group(1)), int(match.group(3))
            for offset in range(int(match.group(2) or first) - first + 1):
                by_port[first + offset] = container
                container.inner[first + offset] = inner + offset
    return by_port


def short_command(args: str) -> str:
    """A command line without the interpreter and paths: pnpm dev, vite --port 1."""
    words = args.split()
    if len(words) > 1 and INTERPRETER.fullmatch(os.path.basename(words[0]).lower()) \
            and not words[1].startswith("-"):
        words = words[1:]
    return " ".join([os.path.basename(words[0])] + words[1:]) if words else ""


def count_connections(text: str) -> Counter:
    """Open connections per local port, from `lsof -F n` on established sockets."""
    counts: Counter = Counter()
    for line in text.splitlines():
        if line.startswith("n") and "->" in line:
            port = port_of(line[1:].partition("->")[0])
            if port is not None:
                counts[port] += 1
    return counts


def find_logs(text: str) -> Tuple[Dict[int, str], Dict[int, str]]:
    """Per pid its stdout when that is a file, and the file its output goes to:
    that stdout, else the first .log file it has open (symfony's server). From
    `lsof -F pftn`."""
    stdout, open_logs = {}, {}
    pid, fd, kind = 0, "", ""
    for line in text.splitlines():
        tag, value = line[:1], line[1:]
        if tag == "p":
            pid = int(value)
        elif tag == "f":
            fd = value
        elif tag == "t":
            kind = value
        elif tag == "n" and kind == "REG":
            if fd == "1":
                stdout[pid] = value
            elif value.endswith(".log"):
                open_logs.setdefault(pid, value)
    return stdout, {**open_logs, **stdout}


# Tools that run a server for you: a restart reruns the topmost of them.
PACKAGE_MANAGERS = {"npm", "npx", "pnpm", "yarn", "bun", "bunx"}
RUNNERS = PACKAGE_MANAGERS | {"turbo", "nx", "nodemon", "concurrently", "tsx", "ts-node", "deno"}


def read_processes() -> Dict[int, Tuple[int, str]]:
    """Every process: pid to parent and command line."""
    procs = {}
    for line in run(["ps", "-A", "-o", "pid=,ppid=,command="]).splitlines():
        parts = line.split(None, 2)
        if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
            procs[int(parts[0])] = (int(parts[1]), parts[2] if len(parts) == 3 else "")
    return procs


def runner_name(args: str) -> str:
    short = short_command(args)
    return short.split(" ")[0] if short else ""


def launcher_of(pid: int, procs: Dict[int, Tuple[int, str]]) -> int:
    """The process that started a server: from the server up through the tools
    that run it (pnpm, npm, turbo, nodemon), stopping below anything else, such
    as a shell, a script like wt, or launchd."""
    current = pid
    while True:
        parent = procs.get(current, (0, ""))[0]
        if parent <= 1 or parent not in procs or runner_name(procs[parent][1]) not in RUNNERS:
            return current
        current = parent


def descendants(pid: int, procs: Dict[int, Tuple[int, str]]) -> List[int]:
    children: Dict[int, List[int]] = {}
    for child, (parent, _) in procs.items():
        children.setdefault(parent, []).append(child)
    found, todo = [], [pid]
    while todo:
        for child in children.get(todo.pop(), []):
            found.append(child)
            todo.append(child)
    return found


def has_terminal(tty: str) -> bool:
    """Whether ps's tty is a terminal: without one ps shows ?? on macOS and ? on Linux."""
    return tty not in ("", "?", "??")


def restart_argv(args: str, cwd: str) -> Optional[List[str]]:
    """The command to run again, or None when it cannot be found any more. A
    package manager runs through PATH: the folder it ran from, such as the bin
    of an fnm shell that has closed, may be gone. ps joins arguments with
    spaces, so an argument that held a space does not come back."""
    words = args.split()
    if not words:
        return None
    short = short_command(args).split()
    if short and short[0] in PACKAGE_MANAGERS and shutil.which(short[0]):
        return short
    program = words[0]
    found = os.path.exists(os.path.join(cwd, program)) if "/" in program else shutil.which(program)
    return words if found else None


def default_log(item: Listener) -> str:
    name = item.place.repo if item.place else re.sub(r"\W+", "-", label(item))
    return os.path.join(HOME, ".cache", "portly", f"{name}-{item.port}.log")


def wt_env(stack: Stack, place: Place) -> Dict[str, str]:
    """The variables of its worktree that wt hands every dev server it starts,
    rebuilt from its registry entry: without them a worktree's server comes
    back on the main checkout's ports or database. What wt reads from its
    config, such as WT_PRODUCT_BASE, is not in the registry."""
    env = {"WT_PROJECT": stack.name, "WT_INDEX": str(stack.index), "WT_REPO_ROOT": stack.path,
           "WT_DB_NAME": stack.db, "WT_PRIMARY_ROOT": main_checkout(place.common)}
    env.update((f"WT_PORT_{role.upper().replace('-', '_')}", str(port)) for role, port in stack.ports.items())
    return env


def env_note(plan: Restart) -> str:
    """What a restart keeps of the environment. ps cannot show a process's
    environment on recent macOS, so only wt's variables come back, and a
    command line such as PORT=3001 pnpm dev comes back as pnpm dev."""
    return "only wt's environment variables are kept" if plan.env else "environment variables are not kept"


def plan_restart(item: Listener, procs: Dict[int, Tuple[int, str]],
                 cwds: Dict[int, str]) -> Tuple[Optional[Restart], str]:
    """How to restart a process, or why that cannot be done."""
    if is_orphan(item):
        return None, "its folder no longer exists"
    if is_docker_itself(item):
        return None, LEAVE_DOCKER
    if not is_dev(item):
        return None, "not a dev server: restart apps yourself"
    launcher = launcher_of(item.pid, procs)
    cwd = item.cwd if launcher == item.pid else cwds.get(launcher, "")
    if not cwd or not os.path.isdir(cwd):
        return None, "the folder of its start command is unknown"
    args = procs.get(launcher, (0, item.args))[1]
    argv = restart_argv(args, cwd)
    if not argv:
        return None, f"cannot find its start command: {short_command(args)}"
    pidfile = ""
    if item.stack and item.stack.registry:
        candidate = item.stack.pid_file(item.stack.role_of(item.port))
        pidfile = candidate if os.path.exists(candidate) else ""
    # Output already going to a file means it ran in the background anyway.
    terminal = item.tty if has_terminal(item.tty) and not item.stdout else ""
    env = wt_env(item.stack, item.place) if item.stack and item.place else {}
    return Restart(argv, cwd, [launcher] + descendants(launcher, procs), item.stdout or default_log(item),
                   pidfile, terminal, env), ""


def add_restart_plans(listeners: List[Listener]) -> None:
    procs = read_processes()
    processes = [item for item in listeners if not item.container]
    launchers = {item.pid: launcher_of(item.pid, procs) for item in processes}
    others = ",".join(sorted({str(pid) for pid in launchers.values() if pid not in launchers}))
    cwds, pid = {}, 0
    for line in (run(["lsof", "-a", "-p", others, "-d", "cwd", "-Fpn"]) if others else "").splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n"):
            cwds[pid] = line[1:]
    for item in processes:
        item.restart, item.restart_problem = plan_restart(item, procs, cwds)


def add_deep_info(listeners: List[Listener]) -> None:
    """Parents, output files, open connections and restart plans, for the detail views."""
    ppids = ",".join(sorted({str(item.ppid) for item in listeners if item.ppid > 1}))
    parents = {}
    for line in (run(["ps", "-o", "pid=,command=", "-p", ppids]) if ppids else "").splitlines():
        pid, _, args = line.strip().partition(" ")
        if pid.isdigit():
            parents[int(pid)] = short_command(args.strip())
    pids = ",".join(sorted({str(item.pid) for item in listeners}))
    stdouts, logs = find_logs(run(["lsof", "-p", pids, "-Fpftn"]))
    counts = count_connections(run(["lsof", "-nP", "-iTCP", "-sTCP:ESTABLISHED", "-Fn"]))
    for item in listeners:
        item.parent = parents.get(item.ppid, "")
        item.log = logs.get(item.pid, "")
        item.stdout = stdouts.get(item.pid, "")
        item.connections = counts.get(item.port, 0)
    add_restart_plans(listeners)


def read_listeners(deep: bool = False) -> List[Listener]:
    listeners = parse_lsof(run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fpcn"]))
    if not listeners:
        return listeners
    lookup = Lookup()
    add_process_info(listeners, lookup)
    # Without Docker, with its daemon down, or while it does not answer, this is
    # empty. Only docker's hang means that: a hanging lsof is no empty list.
    try:
        containers = parse_docker(run(["docker", "ps", "--format", DOCKER_FORMAT]))
    except subprocess.TimeoutExpired:
        containers = {}
    add_containers(listeners, containers)
    for item in listeners:
        if item.container:
            item.place, item.stack = lookup.container_home(item.container)
        elif item.place:
            item.stack = lookup.stack_at(item.place)
    if deep:
        add_deep_info(listeners)
    return listeners


def add_containers(listeners: List[Listener], containers: Dict[int, Container]) -> None:
    """Give each listener the container whose port it listens on. Beside a
    server of its own on that port, such as a local Postgres on 127.0.0.1:5432
    next to a Postgres container on *:5432, only the runtime's listener is the
    container's."""
    runtime_ports = {item.port for item in listeners if is_runtime(item)}
    for item in listeners:
        if item.port not in runtime_ports or is_runtime(item):
            item.container = containers.get(item.port)


def one_per_port(listeners: List[Listener]) -> List[Listener]:
    """One row per port, sorted by port. When workers share the port with
    their parent (php-fpm), the parent stands for them. Another server on the
    port, such as a local Postgres beside a Postgres container, goes in the
    row's others; the row is a container before a dev server before an app,
    so a shared port keeps its place in the list. A runtime that publishes a
    port with a process per address, as docker-proxy does on Linux, is one
    server."""
    by_port = {}
    for item in listeners:
        by_port.setdefault(item.port, []).append(item)
    kept = []
    for _, group in sorted(by_port.items()):
        pids = {item.pid for item in group}
        roots = [item for item in group if item.ppid not in pids] or group
        row = min(roots, key=lambda item: (item.container is None, not is_dev(item), item.pid))
        row.others = [item for item in roots if item is not row and not (is_runtime(item) and is_runtime(row))]
        kept.append(row)
    return kept


# Colour and cursor codes a dev server writes to its log (CSI, OSC such as a
# window title, other escapes), and the other control characters.
TERMINAL_CODES = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]"
                            r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)"
                            r"|\x1b[@-_]"
                            r"|[\x00-\x08\x0b-\x1f\x7f]")
TAIL_BYTES = 16384


def last_lines(path: str, count: int) -> List[str]:
    """The last count lines of a log that hold text, without colour codes;
    of a line a progress bar rewrote in place, what it showed last. Only the
    end of the file is read; a missing file has none."""
    try:
        with open(path, "rb") as log:
            size = log.seek(0, os.SEEK_END)
            log.seek(max(0, size - TAIL_BYTES))
            lines = log.read().decode("utf-8", errors="replace").split("\n")
    except OSError:
        return []
    if size > TAIL_BYTES:
        lines = lines[1:]  # the read began inside this one
    shown = (TERMINAL_CODES.sub("", line.rstrip("\r").rpartition("\r")[2]).replace("\t", " ").strip()
             for line in lines)
    return [line for line in shown if line][-count:]


def down_ports(rows: List[Listener]) -> List[Listener]:
    """A row per port of a wt stack that wt started a server for, but that
    nothing listens on, such as the api of a stack whose web still runs, in
    its worktree's group. wt's pid file tells it started one and has not
    stopped it: the registry lists a port for every service, also those wt
    starts no server for, such as a container's. The row's output is wt's
    log for that role. A stack where nothing runs has no row to start from,
    so it gets none."""
    taken = {item.port for item in rows}
    seen: Set[Tuple[str, int]] = set()
    down = []
    for item in rows:
        stack, place = item.stack, item.place
        if not stack or not place or (stack.registry, stack.index) in seen:
            continue
        seen.add((stack.registry, stack.index))
        for role, port in stack.ports.items():
            if port in taken or not os.path.isfile(stack.pid_file(role)):
                continue
            taken.add(port)  # two stacks on the same ports: rows are told apart by port
            log = stack.log_file(role)
            down.append(Listener(port, 0, role, cwd=place.top, place=replace(place, sub=""), stack=stack,
                                 is_down=True, log=log if os.path.isfile(log) else "",
                                 last_output=last_lines(log, 10)))
    return down


def with_down_ports(rows: List[Listener]) -> List[Listener]:
    """rows and the stack ports that are down, by port. Only for showing:
    a down row has no process to stop or restart."""
    return sorted(rows + down_ports(rows), key=lambda item: item.port)


def drop_helpers(rows: List[Listener]) -> List[Listener]:
    """Drop a process whose parent listens too, such as php-fpm under the
    symfony server: its port is internal. A down row's pid 0 is nobody's
    parent, also not of a process whose ppid is 0, such as launchd."""
    pids = {item.pid for item in rows if not item.is_down}
    return [item for item in rows if item.ppid not in pids]


# Container runtimes publish container ports on the host from a process of
# their own: Docker Desktop's com.docker.backend, docker-proxy on Linux,
# rootless Docker's rootlesskit, OrbStack Helper, Podman machine's gvproxy and
# Lima's limactl hostagent, which Colima and Rancher Desktop run too. When
# docker does not say which container a port is, such a port looks like a plain
# process.
DOCKER_ITSELF = re.compile(r"com\.docke.*|dockerd|docker-proxy|vpnkit.*|rootlessk.*|OrbStack.*|gvproxy|limactl")
# Others are known by their command line. ps joins a program's path and its
# arguments with spaces, so /Applications/Rancher Desktop.app/.../limactl has no
# name to read. Podman machine's VM (vfkit, krunkit) listens for its API, and
# stopping it stops every container all the same; your own vfkit VM has no
# Podman machine files.
RUNTIME_ARGS = re.compile(r"(?:^|/)(?:limactl hostagent |(?:vfkit|krunkit) .*/containers/podman/machine/)")
# Lima's ssh forwarder (Colima's default) is the ssh master on an instance's
# control socket, and Lima's QEMU VM holds the VM's ssh port: both name the
# instance folder. That folder is in ~/.lima, ~/.colima/_lima (or
# ~/.config/colima/_lima) or rancher-desktop/lima, or holds the lima.yaml of an
# instance under a LIMA_HOME of its own. Any other ssh or QEMU, such as your own
# ssh -L, is yours to stop.
LIMA_FOLDER = re.compile(r"^ssh: (.+)/ssh\.sock \[mux\]|(?:^|/)ssh .*ControlPath=\"?(.+?)/ssh\.sock"
                         r"|(?:^|/)qemu-system-\S+ .*-pidfile (.+?)/qemu\.pid")
LIMA_HOMES = re.compile(r".*/(?:\.lima|\.?colima/_lima|rancher-desktop/lima)/[^/]+")
LEAVE_DOCKER = "that is the container runtime itself, not one container: portly leaves it running"


def names_lima_instance(args: str) -> bool:
    match = LIMA_FOLDER.search(args)
    folder = next(filter(None, match.groups()), "") if match else ""
    return bool(folder) and bool(LIMA_HOMES.fullmatch(folder) or os.path.isfile(os.path.join(folder, "lima.yaml")))


def is_runtime(item: Listener) -> bool:
    """A container runtime's process by its command, also one that publishes
    a container's port."""
    words = item.args.split()
    exe = os.path.basename(words[0]) if words else ""
    return (any(DOCKER_ITSELF.fullmatch(name) for name in (exe, item.command))
            or bool(RUNTIME_ARGS.search(item.args)) or names_lima_instance(item.args))


def is_docker_itself(item: Listener) -> bool:
    """A container runtime's own process, such as Docker's: stopping it stops
    every container with it."""
    return not item.container and is_runtime(item)


def is_dev(item: Listener) -> bool:
    """Dev servers run from a project folder; desktop apps run from /."""
    return bool(item.container) or item.cwd not in ("", "/")


def label(item: Listener) -> str:
    """A short name: the compose service, the tool (vite, next-server,
    symfony) or the script."""
    if item.container:
        return item.container.service or item.container.name
    words = item.args.split()
    if not words:
        return item.command
    exe = os.path.basename(words[0]).rstrip(":")
    if not INTERPRETER.fullmatch(exe.lower()):
        return exe
    exe = exe.lower()
    package = re.search(r"node_modules/(?:\.bin/(?:\.\./)?)?((?:@[^/\s]+/)?[^/\s]+)", item.args)
    if package:
        return package.group(1)
    script = next((word for word in words[1:] if not word.startswith("-")), "")
    if os.path.isabs(script):
        script = os.path.basename(script)
    return f"{exe} {script}" if script else exe


def tilde(path: str) -> str:
    if path == HOME or path.startswith(HOME + os.sep):
        return "~" + path[len(HOME):]
    return path


def short_duration(seconds: int) -> str:
    if seconds < 60:
        return "<1m"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


UNIT_SECONDS = {"second": 1, "minute": 60, "hour": 3600, "day": 86400,
                "week": 7 * 86400, "month": 30 * 86400, "year": 365 * 86400}


def docker_age(status: str) -> str:
    """Docker's "Up 6 days (healthy)" or "Up About an hour" as 6d or 1h."""
    match = re.match(r"Up (?:About |Less than )?(an?|\d+) (second|minute|hour|day|week|month|year)", status)
    if not match:
        return ""
    count = int(match.group(1)) if match.group(1).isdigit() else 1
    return short_duration(count * UNIT_SECONDS[match.group(2)])


def age_of(item: Listener) -> str:
    return docker_age(item.container.status) if item.container else short_age(item.elapsed)


def etime_seconds(etime: str) -> Optional[int]:
    """ps etime ([[dd-]hh:]mm:ss) in seconds."""
    days, _, clock = etime.strip().rpartition("-")
    parts = clock.split(":")
    if not (days or "0").isdigit() or not 2 <= len(parts) <= 3 or not all(p.isdigit() for p in parts):
        return None
    seconds = 0
    for part in parts:
        seconds = seconds * 60 + int(part)
    return int(days or 0) * 86400 + seconds


def short_age(etime: str) -> str:
    """ps etime as <1m, 12m, 3h or 6d."""
    seconds = etime_seconds(etime)
    return "" if seconds is None else short_duration(seconds)


DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]


def started_at(seconds_ago: int, now: Optional[datetime] = None) -> str:
    """When something started: today 09:02, yesterday 14:10 or Fri 9 Oct 09:02."""
    now = now or datetime.now()
    start = now - timedelta(seconds=seconds_ago)
    clock = start.strftime("%H:%M")
    if start.date() == now.date():
        return f"today {clock}"
    if start.date() == (now - timedelta(days=1)).date():
        return f"yesterday {clock}"
    return f"{DAYS[start.weekday()]} {start.day} {MONTHS[start.month - 1]} {clock}"


class Paint:
    """ANSI colour when on, plain text when off."""

    def __init__(self, on: bool):
        self.on = on

    def __call__(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.on and code and text.strip() else text

    def link(self, url: str) -> str:
        """A clickable url (OSC 8) in terminals that know them."""
        return f"\033]8;;{url}\033\\{self(LINK, url)}\033]8;;\033\\" if self.on else url


BOLD, DIM, WORKTREE, GONE, FREE, ACCENT, LINK = "1", "90", "33", "31", "32", "1;38;5;208", "4;36"


def clip(text: str, width: int) -> str:
    return text if len(text) <= width else text[: max(width - 1, 0)] + "…"


def fit(widths: List[int], mins: List[int], room: int) -> List[int]:
    """Narrow the widest column, a character at a time, until all fit in room."""
    widths = list(widths)
    while sum(widths) > room:
        i = max(range(len(widths)), key=lambda i: widths[i] - mins[i])
        if widths[i] <= mins[i]:
            break
        widths[i] -= 1
    return widths


def is_orphan(item: Listener) -> bool:
    """Still running from a folder that was deleted, such as a removed worktree."""
    return bool(item.cwd) and not os.path.isdir(item.cwd)


@dataclass
class Group:
    """The ports of one project: a checkout, a docker project or a folder."""
    title: str
    branch: str = ""
    is_worktree: bool = False
    path: str = ""
    rows: List[Listener] = field(default_factory=list)


ORPHANS, OTHERS = "folder gone", "other"


def group_of(item: Listener) -> Tuple[tuple, Group]:
    """The group a port belongs to, with its sort key: checkouts by repo with
    the main checkout first, then docker projects, plain folders, servers whose
    folder is gone, and apps."""
    if item.place:
        place = item.place
        key = (0, place.repo, place.is_worktree, place.branch, place.top)
        return key, Group(place.repo, place.branch, place.is_worktree, tilde(place.top))
    if item.container:
        title = f"docker {item.container.project or item.container.name}"
        return (1, title), Group(title, path=tilde(item.container.folder))
    if is_orphan(item):
        return (3,), Group(ORPHANS)
    if is_dev(item):
        return (2, item.cwd), Group(os.path.basename(item.cwd), path=tilde(item.cwd))
    return (4,), Group(OTHERS)


def group_rows(rows: List[Listener]) -> List[Group]:
    groups: Dict[tuple, Group] = {}
    for item in rows:
        key, group = group_of(item)
        groups.setdefault(key, group).rows.append(item)
    return [groups[key] for key in sorted(groups)]


def role_of(item: Listener) -> str:
    """What part of its project a port is: its wt stack's role, its compose
    service or container, else the folder it runs from in its checkout,
    without the first folder of a deeper one: apps/web gives web, and
    apps/web/server web/server, so it stays apart from apps/api/server."""
    role = item.stack.role_of(item.port) if item.stack else ""
    if role:
        return role
    if item.container:
        return item.container.service or item.container.name
    head, _, rest = item.place.sub.partition("/") if item.place else ("", "", "")
    return rest or head


def tool_of(item: Listener) -> str:
    """What runs on a port: the tool or script, or a container's image. A down port runs nothing."""
    if item.is_down:
        return ""
    return item.container.image if item.container else label(item)


# The status column: one glyph per row. Its shape keeps the meaning without colour.
RUNNING, DOWN = "●", "✗"


def status_of(item: Listener) -> Tuple[str, str]:
    return (DOWN, GONE) if item.is_down else (RUNNING, FREE)


def branch_text(branch: str, is_worktree: bool) -> str:
    return f"wt {branch}" if is_worktree else branch


# A line as (text, tone) pieces, so the printed list and the live view share
# one layout: the one paints tones as ANSI, the other as curses attributes.
Segment = Tuple[str, str]
Line = Tuple[Optional[Listener], Optional[Group], List[Segment]]


def to_ansi(segments: List[Segment], paint: Paint) -> str:
    return "".join(paint(tone, text) for text, tone in segments)


def group_stack(group: Group) -> str:
    """wt<n> when a checkout's group is a wt stack. Only a checkout's: the
    group of servers whose folder is gone holds leftovers of any stack."""
    return next((word for word in map(stack_word, group.rows) if word), "") if group.branch else ""


def header_segments(group: Group, width: int) -> List[Segment]:
    """repo · branch · wt1, or repo · branch · worktree for a worktree wt did
    not make, then the path, dim, while it fits. A part that does not fit is
    left out, with what follows it."""
    tone = GONE if group.title == ORPHANS else DIM if group.title == OTHERS else ACCENT
    kind = group_stack(group) or ("worktree" if group.is_worktree else "")
    parts = [(group.title, tone), (group.branch, WORKTREE if group.is_worktree else ""), (kind, WORKTREE)]
    segments: List[Segment] = [("  ", "")]
    room = width - 2
    for text, part_tone in (part for part in parts if part[0]):
        gap = 3 if len(segments) > 1 else 0
        if room - gap < min(len(text), 4):
            break
        if gap:
            segments.append((" · ", DIM))
        text = clip(text, room - gap)
        segments.append((text, part_tone))
        room -= gap + len(text)
    if group.path and room - 2 >= min(len(group.path), 4):
        segments += [("  ", ""), (clip(group.path, room - 2), DIM)]
    return segments


def note_of(item: Listener) -> List[Segment]:
    """The dim text at the end of a row: +1 process when another server
    shares the port, and the folder a server runs from when it is gone.
    Docker's own pid says nothing about the container, so a port with only
    containers beside it says +1 container. A down port notes the last line
    of its log, which is often why it went down."""
    notes: List[Segment] = []
    if item.is_down:
        return [(item.last_output[-1], GONE)] if item.last_output else notes
    if item.others:
        containers = all(other.container for other in item.others)
        kind = ("container", "containers") if containers else ("process", "processes")
        notes.append(("+" + plural(len(item.others), *kind), DIM))
    if is_orphan(item):
        notes.append((tilde(item.cwd), GONE))
    return notes


# A row has every column from this much room on: an 80-column window, whose
# last column the live view leaves empty. Narrower, a row keeps port, name,
# status and age, and its note while that fits.
FULL_ROW = 79


@dataclass
class Columns:
    """What the rows of one list share: the port and age widths that line them up, and each row's age."""
    port_w: int
    age_w: int
    ages: Dict[int, str]


def group_lines(groups: List[Group], width: int) -> List[Line]:
    """Every line of the grouped list: a header per group, a row per port and
    a blank line between groups. Columns line up across groups."""
    rows = [item for group in groups for item in group.rows]
    if not rows:
        return []
    ages = {id(item): age_of(item) for item in rows}
    columns = Columns(max(len(str(item.port)) for item in rows), max(map(len, ages.values())), ages)
    row_segments = (full_rows if width >= FULL_ROW else narrow_rows)(rows, width, columns)
    lines: List[Line] = []
    for group in groups:
        if lines:
            lines.append((None, None, []))
        lines.append((None, group, header_segments(group, width)))
        lines += [(item, group, row_segments[id(item)]) for item in group.rows]
    return lines


def port_segments(item: Listener, columns: Columns) -> List[Segment]:
    return [("    ", ""), (str(item.port).rjust(columns.port_w), DIM if item.is_down else BOLD)]


def row_end(item: Listener, columns: Columns, width: int, segments: List[Segment]) -> List[Segment]:
    """segments, then status, age and each note that fits."""
    segments = segments + [("  ", ""), status_of(item), ("  ", ""), (columns.ages[id(item)].rjust(columns.age_w), DIM)]
    for text, tone in note_of(item):
        room = width - sum(len(piece) for piece, _ in segments) - 2
        if room >= min(len(text), 4):
            segments += [("  ", ""), (clip(text, room), tone)]
    return segments


def full_rows(rows: List[Listener], width: int, columns: Columns) -> Dict[int, List[Segment]]:
    """Per row: port, role, tool, status, age and the note, which gets what is left."""
    roles = {id(item): role_of(item) for item in rows}
    tools = {id(item): tool_of(item) for item in rows}
    widths = [max(map(len, col.values())) for col in (roles, tools)]
    gaps = 2 * sum(1 for w in widths if w)
    role_w, tool_w = fit(widths, [min(w, 8) for w in widths], width - 4 - columns.port_w - gaps - 5 - columns.age_w)
    lines = {}
    for item in rows:
        segments = port_segments(item, columns)
        if role_w:
            segments += [("  ", ""), (clip(roles[id(item)], role_w).ljust(role_w), DIM if item.is_down else "")]
        if tool_w:
            segments += [("  ", ""), (clip(tools[id(item)], tool_w).ljust(tool_w), DIM)]
        lines[id(item)] = row_end(item, columns, width, segments)
    return lines


def narrow_rows(rows: List[Listener], width: int, columns: Columns) -> Dict[int, List[Segment]]:
    """Per row: port, its role or else its tool, status, age, and the note while it fits."""
    names = {id(item): role_of(item) or tool_of(item) for item in rows}
    name_w = max(1, min(max(map(len, names.values())), width - 4 - columns.port_w - 2 - 5 - columns.age_w))
    return {id(item): row_end(item, columns, width, port_segments(item, columns) + [
        ("  ", ""), (clip(names[id(item)], name_w).ljust(name_w), DIM if item.is_down else "")]) for item in rows}


def render_groups(groups: List[Group], paint: Paint, width: int) -> List[str]:
    return [to_ansi(segments, paint).rstrip() for _, _, segments in group_lines(groups, width)]


def haystack(item: Listener) -> str:
    """Everything a filter word can match, lower case."""
    words = [str(item.port), label(item), item.cwd]
    if item.place:
        words += [item.place.repo, item.place.branch, item.place.top]
    if item.container:
        c = item.container
        words += [c.name, c.project, c.service, c.image]
    if item.stack:
        words.append(f"wt{item.stack.index}")
    if is_orphan(item):
        words.append(ORPHANS)
    return "\n".join(words).lower()


# A filter word that names one wt stack whole: wt1 is not part of wt10.
STACK_WORD = re.compile(r"wt\d+")
# The folder wt makes for a worktree by default: .claude/worktrees/<branch>-wt<n>.
WT_FOLDER = re.compile(r"/\.claude/worktrees/[^/]+-(wt\d+)(?:/|$)")


def stack_word(item: Listener) -> str:
    """wt<n> for a port of wt's stack n, known from wt's registry or, once its
    entry is gone, from the compose project <name>-wt<n> or the removed
    worktree folder a server still runs from; else empty."""
    if item.stack:
        return f"wt{item.stack.index}"
    if item.container:
        found = re.fullmatch(r".+-(wt\d+)", item.container.project)
    else:
        found = WT_FOLDER.search(item.cwd) if is_orphan(item) else None
    return found.group(1) if found else ""


def matches(item: Listener, terms: List[str]) -> bool:
    """True when any of the filter words occurs in the port's project, branch,
    folder, tool or container. A stack word such as wt1 only matches the ports
    of that stack, not those of wt10 or a branch or folder that contains it."""
    text, stack = haystack(item), stack_word(item)
    return any(term == stack if STACK_WORD.fullmatch(term) else term in text
               for term in map(str.lower, terms))


def terminal_width() -> int:
    """The terminal's width; a pty that reports none still gets room to work in."""
    columns = shutil.get_terminal_size((120, 24)).columns
    return columns if columns >= 40 else 120


def plural(count: int, one: str, many: str) -> str:
    return f"{count} {one if count == 1 else many}"


# Ports that speak a database protocol, not http: no url for them.
NOT_HTTP = {3306, 5432, 6379, 9042, 11211, 27017, 5672}
LOOPBACK = re.compile(r"127\.[\d.]+|\[::1\]|localhost")


def url_of(item: Listener) -> str:
    if item.is_down:
        return ""
    inner = item.container.inner.get(item.port) if item.container else None
    if item.port in NOT_HTTP or inner in NOT_HTTP:
        return ""
    # The symfony server speaks https unless started with --no-tls.
    secure = label(item) == "symfony" and "--no-tls" not in item.args
    return f"{'https' if secure else 'http'}://localhost:{item.port}"


def is_local_only(item: Listener) -> bool:
    return bool(item.addresses) and all(LOOPBACK.fullmatch(address) for address in item.addresses)


def output_of(item: Listener) -> str:
    """Where a process's output goes."""
    if item.log:
        return tilde(item.log)
    if item.is_down:
        return "no log from wt"
    if has_terminal(item.tty):
        return f"terminal {item.tty}"
    return "no terminal or log file"


def detail_fields(item: Listener, rows: Optional[List[Listener]] = None) -> List[Tuple[str, str, str, str]]:
    """Key, value, the value's tone and a dim note per line of the detail views.
    rows, all ports, name the others a restart takes along."""
    fields = []

    def add(key: str, value: str, tone: str = "", note: str = "") -> None:
        fields.append((key, value, tone, note))

    if item.place:
        add("project", f"{item.place.repo} · {branch_text(item.place.branch, item.place.is_worktree)}")
    if item.stack:
        role = next((role for role, port in item.stack.ports.items() if port == item.port), "")
        add("stack", f"wt {item.stack.index} of {item.stack.name}", note=role)
    if item.is_down:
        add("state", "down", GONE, "nothing listens on it")
        add("output", output_of(item))
        for number, line in enumerate(item.last_output):
            add("last lines" if number == 0 else "", line, GONE if number == len(item.last_output) - 1 else DIM)
        return fields
    if item.container:
        c = item.container
        add("container", c.name)
        add("image", c.image)
        if c.project:
            add("compose", f"{c.project} · {c.service}", note=tilde(c.folder))
        inner = c.inner.get(item.port)
        if inner and inner != item.port:
            add("inside", f"port {inner} in the container")
        add("status", c.status, GONE if "unhealthy" in c.status else "")
    else:
        orphan = is_orphan(item)
        add("folder", tilde(item.cwd), GONE if orphan else "", "gone" if orphan else "")
        add("command", item.args.replace(HOME, "~") or item.command)
        parent = f"started by {item.parent} ({item.ppid})" if item.parent else \
            "detached from its terminal" if item.ppid == 1 else ""
        add("pid", str(item.pid), note=parent)
        seconds = etime_seconds(item.elapsed)
        add("running", age_of(item), note=f"since {started_at(seconds)}" if seconds is not None else "")
        if item.rss_kb:
            add("memory", f"{round(item.rss_kb / 1024)} MB", note=f"cpu {item.cpu}%")
        add("output", output_of(item))
    for other in item.others:
        what = f"container {other.container.name}" if other.container else f"pid {other.pid} ({label(other)})"
        add("also", what, note=" ".join(other.addresses))
    if item.addresses:
        if is_local_only(item):
            add("reach", "this Mac only" if sys.platform == "darwin" else "this computer only",
                note=" ".join(item.addresses))
        else:
            add("reach", "your network too", WORKTREE, " ".join(item.addresses))
    if item.connections >= 0:
        add("connections", f"{item.connections} open")
    if item.container or item.restart:
        add("restart", restart_summary(item, rows or [item]), note=env_note(item.restart) if item.restart else "")
    elif item.restart_problem:
        add("restart", "not possible", DIM, item.restart_problem)
    return fields


def hints_for(item: Listener) -> List[str]:
    if item.is_down:
        return [f"portly logs {item.port}"] if item.log else []
    hints = []
    if url_of(item):
        hints.append(f"portly open {item.port}")
    if item.container or item.log:
        hints.append(f"portly logs {item.port}")
    if item.container or item.restart:
        hints.append(f"portly restart {item.port}")
    if not is_docker_itself(item):
        hints.append(f"portly kill {item.port}")
    return hints


def render_detail(item: Listener, paint: Paint, rows: Optional[List[Listener]] = None) -> List[str]:
    port = str(item.port)
    url = url_of(item)
    lines = [f"  {paint(BOLD, port)}  {paint(BOLD, label(item))}" + (f"  {paint.link(url)}" if url else "")]
    indent = " " * (len(port) + 4)
    fields = detail_fields(item, rows)
    key_w = max(len(key) for key, *_ in fields) + 2
    for key, value, tone, note in fields:
        lines.append(f"{indent}{paint(DIM, key.ljust(key_w))}{paint(tone, value)}"
                     + (f"  {paint(DIM, note)}" if note else ""))
    lines.append("")
    lines.append(indent + paint(DIM, "  ·  ".join(hints_for(item))))
    return lines


LSOF_LISTEN = ["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fpcn"]


def listening_ports(besides: Optional[Dict[int, Set[int]]] = None) -> set:
    """The ports something listens on. besides gives per port the pids that do
    not count, such as another server beside the one that is restarting."""
    besides = besides or {}
    return {item.port for item in parse_lsof(run(LSOF_LISTEN)) if item.pid not in besides.get(item.port, ())}


def listening_pids(port: int) -> List[int]:
    return [int(pid) for pid in run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"]).split()]


def wait_for_ports(ports: List[int], seconds: float, besides: Optional[Dict[int, Set[int]]] = None) -> set:
    """Wait until none of ports listens, but for besides; the ones still taken when time is up."""
    deadline = time.monotonic() + seconds
    while True:
        busy = set(ports) & listening_ports(besides)
        if not busy or time.monotonic() > deadline:
            return busy
        time.sleep(0.1)


def listeners_by_port() -> Dict[int, List[Listener]]:
    found: Dict[int, List[Listener]] = {}
    for item in parse_lsof(run(LSOF_LISTEN)):
        found.setdefault(item.port, []).append(item)
    return found


def wait_until_gone(pids: Dict[int, List[int]], seconds: float) -> Dict[int, List[Listener]]:
    """Wait until none of the pids listens on its port any more; what listens
    per port when that is so or time is up."""
    deadline = time.monotonic() + seconds
    while True:
        found = listeners_by_port()
        left = any(item.pid in pids.get(port, ()) for port, items in found.items() for item in items)
        if not left or time.monotonic() > deadline:
            return found
        time.sleep(0.1)


def docker(args: List[str], timeout: float) -> subprocess.CompletedProcess:
    """Run a docker command that changes containers; one place, so tests can fence it off.
    A docker that does not answer in time fails with that as its reason."""
    cmd = ["docker", *args]
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 1, "", f"docker did not answer within {int(timeout)}s")


def send(pid: int, sig: int) -> Optional[str]:
    """Signal pid; a reason when that is not allowed. A pid that is already
    gone is fine: it was going to stop anyway. Pid 0 and -1 signal whole
    groups of processes, and pid 1 is launchd or init. A down row has pid 0."""
    if pid <= 1:
        return f"refused to signal pid {pid}"
    try:
        os.kill(pid, sig)
    except ProcessLookupError:
        pass
    except PermissionError:
        return f"no permission to stop pid {pid}"
    return None


def own_pids(item: Listener, procs: Dict[int, Tuple[int, str]]) -> List[int]:
    """What stopping item may SIGKILL: item and what runs under it, such as
    php-fpm's workers on its socket, never Docker itself. Children come before
    their parent, so none is signalled after its parent is gone and it was
    handed to launchd."""
    under = [pid for pid in descendants(item.pid, procs)[::-1]
             if not is_docker_itself(Listener(item.port, pid, "", args=procs[pid][1]))]
    return under + [item.pid]


def kill_late(late: Dict[int, List[int]]) -> Dict[int, str]:
    """SIGKILL the pids that outlived their SIGTERM; per port the reason when that is not allowed."""
    problems = {}
    for port, pids in late.items():
        for pid in pids:
            problem = send(pid, signal.SIGKILL)
            if problem:
                problems[port] = problem
    return problems


def taken_by(holders: List[Listener], procs: Dict[int, Tuple[int, str]]) -> str:
    """Who keeps a port taken: pid 123 (vite) listens on it. lsof only names
    the executable, node for vite, so the name comes from the command line."""
    for item in holders:
        item.args = procs.get(item.pid, (0, ""))[1]
    names = ", ".join(f"pid {item.pid} ({label(item)})" for item in sorted(holders, key=lambda item: item.pid))
    return f"{names} {'listens' if len(holders) == 1 else 'listen'} on it"


def stop_many(rows: List[Listener]) -> Dict[int, Optional[str]]:
    """Free the ports of rows: one docker stop for the containers, SIGTERM for
    the processes and after five seconds SIGKILL for those that still listen on
    their port. Another server on that port, one of the row's others, is left
    running. Per port None once free, else the reason it is still taken,
    which names what still listens on it."""
    problems: Dict[int, str] = {}
    containers = [item for item in rows if item.container]
    if containers:
        names = sorted({item.container.name for item in containers})
        done = docker(["stop", *names], timeout=120)
        if done.returncode != 0:
            reason = (done.stderr.strip().splitlines() or ["docker stop failed"])[-1]
            problems.update((item.port, reason) for item in containers)
    processes = [item for item in rows if not item.container and not is_docker_itself(item)]
    problems.update((item.port, LEAVE_DOCKER) for item in rows if is_docker_itself(item))
    procs = read_processes()
    own = {item.port: own_pids(item, procs) for item in processes}
    for item in processes:
        problem = send(item.pid, signal.SIGTERM)
        if problem:
            problems[item.port] = problem
    waiting = {item.port: own.get(item.port, [item.pid]) for item in rows if item.port not in problems}
    found = wait_until_gone(waiting, 5)
    # Only a process gets SIGKILL: on a container's port listens Docker itself.
    listening = {port: {item.pid for item in items} for port, items in found.items()}
    late = {port: [pid for pid in pids if pid in listening.get(port, ())]
            for port, pids in own.items() if port in waiting}
    problems.update(kill_late(late))
    if any(late.values()):
        found = wait_until_gone(late, 2)
    if any(item.port in found and item.port not in problems for item in rows):
        procs = read_processes()  # a supervisor may have started the server again
    return {item.port: (problems.get(item.port) or taken_by(found[item.port], procs)) if item.port in found
            else None for item in rows}


def stop(item: Listener) -> Optional[str]:
    return stop_many([item])[item.port]


def is_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # it exists, it is just not ours
    return True


def stop_tree(pids: List[int], ports: List[int], besides: Optional[Dict[int, Set[int]]] = None) -> Optional[str]:
    """SIGTERM a launcher and everything under it; after five seconds SIGKILL
    what is left. A reason when the ports stay taken by anything but besides."""
    for pid in pids:
        problem = send(pid, signal.SIGTERM)
        if problem:
            return problem
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline and (any(map(is_alive, pids)) or set(ports) & listening_ports(besides)):
        time.sleep(0.1)
    for pid in pids:
        if is_alive(pid):
            send(pid, signal.SIGKILL)
    return "the port stayed taken" if wait_for_ports(ports, 2, besides) else None


def start(plan: Restart) -> int:
    """Run the plan's command in its folder, detached, its output appended to
    the plan's log. The new pid goes into wt's pid file when there is one."""
    os.makedirs(os.path.dirname(plan.log), exist_ok=True)
    with open(plan.log, "a") as log:
        log.write(f"\n── portly restart {datetime.now():%Y-%m-%d %H:%M:%S}: {' '.join(plan.argv)} ──\n")
        log.flush()
        # wt's variables in portly's own shell belong to the worktree portly runs in, not to this server.
        env = {key: value for key, value in os.environ.items() if not key.startswith("WT_")}
        env.update(plan.env)
        process = subprocess.Popen(plan.argv, cwd=plan.cwd, env=env, stdin=subprocess.DEVNULL, stdout=log,
                                   stderr=subprocess.STDOUT, start_new_session=True)
    if plan.pidfile:
        with open(plan.pidfile, "w") as pidfile:
            pidfile.write(f"{process.pid}\n")
    return process.pid


def restart_many(rows: List[Listener], timeout: float = 60) -> Dict[int, Optional[str]]:
    """Restart the ports of rows: one docker restart for the containers; a
    process is stopped with its launcher and the launcher runs again. A
    launcher that serves several ports (turbo) restarts once. Per port None
    once it listens again, else the reason."""
    results: Dict[int, Optional[str]] = {}
    containers = [item for item in rows if item.container]
    if containers:
        names = sorted({item.container.name for item in containers})
        done = docker(["restart", *names], timeout=300)
        if done.returncode != 0:
            reason = (done.stderr.strip().splitlines() or ["docker restart failed"])[-1]
            results.update((item.port, reason) for item in containers)
    plans: Dict[int, Tuple[Restart, List[Listener]]] = {}
    for item in rows:
        if item.container:
            continue
        if not item.restart:
            results[item.port] = item.restart_problem or "no restart plan"
            continue
        plans.setdefault(item.restart.pids[0], (item.restart, []))[1].append(item)
    besides = others_on_ports([pid for plan, _ in plans.values() for pid in plan.pids])
    for plan, items in plans.values():
        ports = [item.port for item in items]
        problem = stop_tree(plan.pids, ports, besides)
        if not problem:
            try:
                start(plan)
            except OSError as error:
                problem = f"start failed: {error}"
        if problem:
            results.update((port, problem) for port in ports)
    waiting = [item.port for item in rows if item.port not in results]
    if waiting:
        wait_for_listen(waiting, timeout, besides=besides)
        taken = listening_ports(besides)
        logs = {item.port: item.restart.log for item in rows if item.restart}
        for port in waiting:
            late = f"not listening after {int(timeout)}s" + (f", see {tilde(logs[port])}" if port in logs else "")
            results[port] = None if port in taken else late
    return results


def others_on_ports(pids: List[int]) -> Dict[int, Set[int]]:
    """Per port what listens on it now outside pids, such as a second server
    on [::1] with its workers: it keeps running through a restart of pids, and
    does not count as the port listening again."""
    return {port: {item.pid for item in items if item.pid not in pids}
            for port, items in listeners_by_port().items()}


def restart_summary(item: Listener, rows: List[Listener]) -> str:
    """What a restart of item runs, for the detail views and the question."""
    if item.container:
        return f"docker restart {item.container.name}"
    if not item.restart:
        return ""
    plan = item.restart
    others = sorted(row.port for row in rows if row.port != item.port and not row.container
                    and row.restart and row.restart.pids[0] == plan.pids[0])
    text = f"{short_command(' '.join(plan.argv))} in {tilde(plan.cwd)}"
    return text + (f" (also {', '.join(map(str, others))})" if others else "")


def show_ports(ports: List[int], rows: List[Listener], paint: Paint) -> int:
    by_port = {item.port: item for item in rows}
    lines = []
    for port in ports:
        item = by_port.get(port)
        if lines:
            lines.append("")
        if item:
            lines += render_detail(item, paint, rows)
        else:
            lines.append(f"  {paint(BOLD, str(port))} is {paint(FREE, 'free')}.")
    print("\n" + "\n".join(lines) + "\n")
    return 0


def pick_targets(rows: List[Listener], ports: List[int], terms: List[str]) -> Tuple[List[Listener], List[int]]:
    """What to stop, by port, and the asked ports that are already free. A
    word picks every dev server it matches; helpers stop with their parent."""
    by_port = {item.port: item for item in rows}
    chosen = {port: by_port[port] for port in ports if port in by_port}
    if terms:
        for item in visible(rows, terms, show_all=False):
            chosen.setdefault(item.port, item)
    return [chosen[port] for port in sorted(chosen)], [port for port in ports if port not in by_port]


def confirm(question: str) -> Optional[bool]:
    """Ask yes or no on the terminal; None when there is no one to ask."""
    if not sys.stdin.isatty():
        return None
    try:
        return input(question).strip().lower() in ("y", "yes")
    except EOFError:
        return False


def kill(rows: List[Listener], ports: List[int], terms: List[str], sure: bool, paint: Paint,
         ask=confirm) -> int:
    """Stop the asked ports at once; a project or stack only after a yes."""
    targets, free = pick_targets(rows, ports, terms)
    lines = [f"  {paint(BOLD, str(port))} is already {paint(FREE, 'free')}." for port in free]
    if terms and not targets:
        print(f"\n  Nothing found for {' '.join(terms)}.\n")
        return 1
    if terms and not sure:
        width = terminal_width()
        print("\n" + "\n".join(render_groups(group_rows(targets), paint, width)) + "\n", flush=True)
        answer = ask(f"  Stop {plural(len(targets), 'port', 'ports')}? [y/N] ")
        if answer is None:
            print("  No terminal to ask: add -y to stop without asking.\n", file=sys.stderr)
            return 2
        if not answer:
            print("  Nothing stopped.\n")
            return 1
    results = stop_many(targets) if targets else {}
    port_w = max([len(str(item.port)) for item in targets] + [0])
    for item in targets:
        name = paint(BOLD, str(item.port).rjust(port_w))
        problem = results[item.port]
        if problem:
            lines.append(f"  {name} is still taken: {paint(GONE, problem)}")
        else:
            lines.append(f"  {name} is {paint(FREE, 'free')}.  {paint(DIM, f'{label(item)} stopped')}")
    print("\n" + "\n".join(lines) + "\n")
    return 1 if any(results.values()) else 0


def restart(rows: List[Listener], ports: List[int], terms: List[str], sure: bool, paint: Paint,
            ask=confirm) -> int:
    """Restart the asked ports at once; a project or stack only after a yes.
    The plan for every port is shown first."""
    targets, free = pick_targets(rows, ports, terms)
    lines = [f"  {paint(BOLD, str(port))} is not listening: there is nothing to restart." for port in free]
    if terms and not targets:
        print(f"\n  Nothing found for {' '.join(terms)}.\n")
        return 1
    port_w = max([len(str(item.port)) for item in targets] + [0])
    plan_lines = []
    for item in targets:
        plan = restart_summary(item, rows)
        what = paint(DIM, plan) if plan else paint(GONE, f"not possible: {item.restart_problem}")
        plan_lines.append(f"  {paint(BOLD, str(item.port).rjust(port_w))}  {label(item)}  {what}")
        if item.restart and item.restart.terminal:
            note = (f"ran in terminal {item.restart.terminal}; comes back in the background, "
                    f"see portly logs {item.port}")
            plan_lines.append(f"  {' ' * port_w}  {paint(DIM, note)}")
        if item.restart:
            plan_lines.append(f"  {' ' * port_w}  {paint(DIM, env_note(item.restart))}")
    print("\n" + "\n".join(plan_lines) + "\n", flush=True)
    doable = [item for item in targets if item.container or item.restart]
    if terms and not sure and doable:
        answer = ask(f"  Restart {plural(len(doable), 'port', 'ports')}? [y/N] ")
        if answer is None:
            print("  No terminal to ask: add -y to restart without asking.\n", file=sys.stderr)
            return 2
        if not answer:
            print("  Nothing restarted.\n")
            return 1
    if doable and sys.stdout.isatty():
        print(paint(DIM, "  restarting, waiting until everything listens again…"), flush=True)
    results = restart_many(doable) if doable else {}
    for item in doable:
        name = paint(BOLD, str(item.port).rjust(port_w))
        problem = results[item.port]
        if problem:
            lines.append(f"  {name} {paint(GONE, problem)}")
        else:
            lines.append(f"  {name} {paint(FREE, 'listens again')}.  {paint(DIM, label(item))}")
    if lines:
        print("\n".join(lines) + "\n")
    return 1 if any(results.values()) or len(doable) < len(targets) else 0


def logs_command(item: Listener, lines: int, follow: bool) -> Optional[List[str]]:
    """The command that shows a port's output, or None when it writes to no file."""
    if item.container:
        return ["docker", "logs", "--tail", str(lines)] + (["--follow"] if follow else []) + [item.container.name]
    if item.log:
        return ["tail", "-n", str(lines)] + (["-F"] if follow else []) + [item.log]
    return None


def is_bindable(port: int) -> bool:
    """True when a server could listen on port, on localhost and on all addresses."""
    for host in ("127.0.0.1", "0.0.0.0"):
        with socket.socket() as sock:
            try:
                sock.bind((host, port))
            except OSError:
                return False
    return True


def free_ports(start: int, count: int, taken: set) -> List[int]:
    found, port = [], start
    while len(found) < count and port < 65536:
        if port not in taken and is_bindable(port):
            found.append(port)
        port += 1
    return found


SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


def wait_for_listen(ports: List[int], timeout: float, tick=None,
                    besides: Optional[Dict[int, Set[int]]] = None) -> Tuple[bool, float]:
    """Wait until every port listens, but for besides; whether they did, and after
    how long. A timeout of 0 waits for ever. tick(seconds, waiting) runs on every check."""
    start = time.monotonic()
    while True:
        waited = time.monotonic() - start
        listening = listening_ports(besides)
        waiting = [port for port in ports if port not in listening]
        if not waiting:
            return True, waited
        if timeout and waited >= timeout:
            return False, waited
        if tick:
            tick(waited, waiting)
        time.sleep(0.25)


def opener() -> str:
    return "open" if sys.platform == "darwin" else "xdg-open"


def open_in_browser(url: str) -> Optional[str]:
    """Hand url to the system's opener; why that failed, or None. A server,
    WSL or a container may have no xdg-open at all."""
    try:
        done = subprocess.run([opener(), url], check=False)
    except OSError:
        return f"no browser opener found ({opener()})"
    return f"{opener()} could not open it" if done.returncode else None


def port_number(text: str) -> int:
    if not text.isdigit() or not 0 < int(text) < 65536:
        raise argparse.ArgumentTypeError(f"not a port: {text}")
    return int(text)


def as_json(item: Listener, deep: bool = False) -> dict:
    """One port as plain data; fields that do not apply are null. deep adds
    what only the detail views read: log, parent, connections and restart.
    A down port has no process, so only its log, which is wt's."""
    place, stack, container = item.place, item.stack, item.container
    process = not container and not item.is_down
    data = {
        "port": item.port,
        "name": label(item),
        "down": item.is_down,
        "url": url_of(item) or None,
        "addresses": item.addresses,
        "local_only": is_local_only(item),
        "project": place and {"repo": place.repo, "branch": place.branch, "worktree": place.is_worktree,
                              "path": place.top, "folder": place.sub},
        "stack": stack and {"name": stack.name, "index": stack.index,
                            "role": next((r for r, port in stack.ports.items() if port == item.port), None)},
        "container": container and {"name": container.name, "image": container.image,
                                    "status": container.status, "compose_project": container.project or None,
                                    "service": container.service or None,
                                    "inner_port": container.inner.get(item.port)},
        "pid": item.pid if process else None,
        "command": item.args if process else None,
        "cwd": item.cwd if process else None,
        "folder_gone": is_orphan(item),
        "running_seconds": etime_seconds(item.elapsed) if process else None,
        "memory_kb": item.rss_kb if process else None,
        "others": [as_json(other, deep) for other in item.others],
        "last_output": item.last_output[-1] if item.last_output else None,
    }
    if deep:
        plan = item.restart
        data.update(log=item.log or None, parent=item.parent or None,
                    connections=None if item.is_down else item.connections,
                    restart=plan and {"command": plan.argv, "cwd": plan.cwd, "log": plan.log, "env": plan.env},
                    restart_problem=item.restart_problem or None)
    return data


def split_targets(words: List[str]) -> Tuple[List[int], List[str]]:
    """Port numbers and filter words."""
    ports, terms = [], []
    for word in words:
        if word.isdigit():
            ports.append(port_number(word))
        else:
            terms.append(word)
    return ports, terms


def visible(rows: List[Listener], terms: List[str], show_all: bool) -> List[Listener]:
    """The rows to list: dev servers, or everything with -a. A filter that finds
    nothing among the dev servers also looks at apps, so `portly spotify` works."""
    dev = rows if show_all else [item for item in drop_helpers(rows) if is_dev(item)]
    if not terms:
        return dev
    found = [item for item in dev if matches(item, terms)]
    return found or [item for item in rows if matches(item, terms)]


def summary_segments(groups: List[Group]) -> List[Segment]:
    """2 projects · 4 ports, and · 1 down in red when a stack port is."""
    rows = [item for group in groups for item in group.rows]
    down = sum(1 for item in rows if item.is_down)
    segments = [(f"{plural(len(groups), 'project', 'projects')} · {plural(len(rows) - down, 'port', 'ports')}", DIM)]
    return segments + ([(" · ", DIM), (f"{down} down", GONE)] if down else [])


def show_list(rows: List[Listener], terms: List[str], show_all: bool, paint: Paint) -> int:
    rows = visible(rows, terms, show_all)
    if not rows:
        if terms:
            print(f"\n  Nothing found for {' '.join(terms)}.\n")
            return 1
        print("\n  Nothing is listening." + ("" if show_all else " portly -a shows apps too.") + "\n")
        return 0
    width = terminal_width()
    groups = group_rows(rows)
    print("\n" + "\n".join(render_groups(groups, paint, width)) + "\n")
    if sys.stdout.isatty():
        hint = "  ·  portly 3000 for details  ·  portly for the interactive view"
        print(f"  {to_ansi(summary_segments(groups), paint)}{paint(DIM, hint)}\n")
    return 0


def copy_to_clipboard(text: str) -> bool:
    for command in (["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"]):
        if shutil.which(command[0]):
            return subprocess.run(command, input=text, text=True, check=False).returncode == 0
    return False


class Scanner(threading.Thread):
    """Reads every port in the background, every few seconds or on demand."""

    def __init__(self, interval: float = 2.0):
        super().__init__(daemon=True)
        self.interval = interval
        self.lock = threading.Lock()
        self.wake = threading.Event()
        self.rows: Optional[List[Listener]] = None
        self.version = 0
        self.scanned_at = 0.0
        self.error = ""

    def run(self) -> None:
        while True:
            try:
                rows = with_down_ports(one_per_port(read_listeners(deep=True)))
            except Exception as error:  # the view stays up and shows what went wrong
                with self.lock:
                    self.error = f"scan failed: {error}"
            else:
                with self.lock:
                    self.rows, self.version, self.error = rows, self.version + 1, ""
                    self.scanned_at = time.monotonic()
            self.wake.wait(self.interval)
            self.wake.clear()

    def refresh(self) -> None:
        self.wake.set()

    def latest(self) -> Tuple[int, Optional[List[Listener]], str, float]:
        with self.lock:
            return self.version, self.rows, self.error, self.scanned_at


TONES = ["", BOLD, DIM, WORKTREE, GONE, FREE, ACCENT, LINK]


class Styles:
    """Curses attributes per tone, plain and on the selected row."""

    def __init__(self):
        self.normal = {tone: 0 for tone in TONES}
        self.selected = {tone: curses.A_REVERSE for tone in TONES}
        self.bar = curses.A_REVERSE | curses.A_BOLD
        extra = {BOLD: curses.A_BOLD, ACCENT: curses.A_BOLD, LINK: curses.A_UNDERLINE}
        if not curses.has_colors():
            self.normal.update(extra)
            return
        curses.start_color()
        curses.use_default_colors()
        rich = curses.COLORS >= 256
        fg = {"": -1, BOLD: -1, DIM: 245 if rich else curses.COLOR_WHITE, WORKTREE: curses.COLOR_YELLOW,
              GONE: curses.COLOR_RED, FREE: curses.COLOR_GREEN, ACCENT: 208 if rich else curses.COLOR_YELLOW,
              LINK: curses.COLOR_CYAN}
        if not rich:
            extra[DIM] = curses.A_DIM
        pair = 1
        for tone in TONES:
            curses.init_pair(pair, fg[tone], -1)
            self.normal[tone] = curses.color_pair(pair) | extra.get(tone, 0)
            curses.init_pair(pair + 1, fg[tone], 237 if rich else -1)
            self.selected[tone] = curses.color_pair(pair + 1) | extra.get(tone, 0) | (0 if rich else curses.A_REVERSE)
            pair += 2
        curses.init_pair(pair, curses.COLOR_BLACK, 208 if rich else curses.COLOR_YELLOW)
        self.bar = curses.color_pair(pair) | curses.A_BOLD


MOUSE_ON, MOUSE_OFF = "\033[?1000h\033[?1006h", "\033[?1000l\033[?1006l"


def terminal_write(text: str) -> None:
    sys.__stdout__.write(text)
    sys.__stdout__.flush()


class KeyReader:
    """Reads keys with curses' own key translation off and decodes escape codes
    itself: arrows in both cursor modes (a terminal or multiplexer that ignores
    application mode sends codes ncurses does not expect), page and home keys,
    and mouse reports in SGR and the old X10 form, which macOS's old ncurses
    cannot read (no SGR, no wheel-down). Keys come back as names: "up",
    "enter", "esc", a plain character, ("click", y) or ("wheel", +1 or -1)."""

    SS3 = {"A": "up", "B": "down", "C": "right", "D": "left", "H": "home", "F": "end"}
    TILDE = {"1": "home", "7": "home", "4": "end", "8": "end", "5": "pgup", "6": "pgdn", "3": "delete"}

    def __init__(self, screen):
        self.screen = screen

    def char(self, wait_ms: int):
        self.screen.timeout(wait_ms)
        try:
            return self.screen.get_wch()
        except curses.error:
            return None  # nothing arrived within wait_ms

    def read(self, wait_ms: int = 100):
        key = self.char(wait_ms)
        if key is None:
            return None
        if key == curses.KEY_RESIZE:
            return "resize"
        if isinstance(key, int):
            return None
        if key == "\x1b":
            return self.escape()
        if key in ("\n", "\r"):
            return "enter"
        if key in ("\x7f", "\b"):
            return "backspace"
        return key

    def escape(self):
        first = self.char(30)
        if first is None:
            return "esc"
        if first == "O":
            return self.SS3.get(self.char(30))
        if first != "[":
            return None  # alt with a key: not used
        body = ""
        while True:
            key = self.char(30)
            if not isinstance(key, str):
                return None
            if body == "" and key == "M":
                return self.x10_mouse()
            body += key
            if "@" <= key <= "~" and not (body.startswith("<") and key not in "Mm"):
                break
        if body.startswith("<"):
            return self.sgr_mouse(body)
        final, params = body[-1], body[:-1].split(";")
        if final == "~":
            return self.TILDE.get(params[0])
        return self.SS3.get(final)

    @staticmethod
    def mouse(button: int, y: int, pressed: bool):
        if button & 64:
            return ("wheel", 1 if button & 1 else -1)
        if pressed and button & 3 == 0:
            return ("click", y)
        return None

    def sgr_mouse(self, body: str):
        match = re.fullmatch(r"<(\d+);(\d+);(\d+)([Mm])", body)
        if not match:
            return None
        return self.mouse(int(match.group(1)), int(match.group(3)) - 1, match.group(4) == "M")

    def x10_mouse(self):
        codes = [self.char(30) for _ in range(3)]
        if not all(isinstance(code, str) for code in codes):
            return None
        button, _, y = (ord(code) - 32 for code in codes)
        return self.mouse(button, y - 1, button & 3 != 3)


class LiveView:
    """portly live: the grouped list on top, the selected port below, keys at the bottom."""

    # The key row: only the keys that do something for the selected row.
    KEYS = [("↑↓", "select"), ("o", "open"), ("l", "logs"), ("r", "restart"), ("k", "stop"),
            ("RK", "stack"), ("?", "keys")]
    # What ? lists: every key.
    ALL_KEYS = [
        ("↑↓ pgup pgdn home end", "select a port; a click selects one, the wheel scrolls"),
        ("o enter", "open its url in the browser"),
        ("c", "copy its url"),
        ("l", "follow its output"),
        ("r", "restart it the way it was started"),
        ("k", "stop it"),
        ("R K", "restart or stop every port of its stack or project"),
        ("/", "filter by project, branch, folder or tool; enter keeps it"),
        ("esc", "clear the filter"),
        ("a", "show apps and helper processes too, or hide them again"),
        ("?", "these keys"),
        ("q", "quit"),
    ]

    def __init__(self, screen, scanner: Scanner, terms: List[str], show_all: bool):
        self.screen, self.scanner = screen, scanner
        self.filter, self.show_all, self.editing = " ".join(terms), show_all, False
        self.all_rows: List[Listener] = []
        self.groups: List[Group] = []
        self.order: List[int] = []  # ports in the order they are listed
        self.selected: Optional[int] = None
        self.last_index = 0
        self.scroll = 0
        self.version, self.error, self.scanned_at = 0, "", 0.0
        self.confirm: Optional[Tuple[str, List[Listener], str]] = None  # question, targets, stop or restart
        self.busy, self.busy_lock = "", threading.Lock()
        self.message, self.message_tone, self.message_at = "", "", 0.0
        self.row_at: Dict[int, int] = {}  # screen line to port, for the mouse
        self.showing_keys = False  # ? shows every key over the list, until the next key

    # --- state

    def pull(self) -> None:
        version, rows, self.error, self.scanned_at = self.scanner.latest()
        if rows is not None and version != self.version:
            self.version, self.all_rows = version, rows
            self.rebuild()

    def rebuild(self, from_top: bool = False) -> None:
        """Regroup after a scan or a new filter. A port that left keeps the cursor
        where it was; a new filter starts at the top."""
        rows = visible(self.all_rows, self.filter.split(), self.show_all)
        self.groups = group_rows(rows)
        self.order = [item.port for group in self.groups for item in group.rows]
        if self.selected not in self.order:
            index = 0 if from_top else min(self.last_index, len(self.order) - 1)
            self.selected = self.order[index] if self.order else None
        if self.selected is not None:
            self.last_index = self.order.index(self.selected)

    def current(self) -> Optional[Listener]:
        return next((item for group in self.groups for item in group.rows if item.port == self.selected), None)

    def current_group(self) -> Optional[Group]:
        return next((group for group in self.groups if any(item.port == self.selected for item in group.rows)), None)

    def move(self, delta: int) -> None:
        if not self.order:
            return
        index = self.order.index(self.selected) if self.selected in self.order else 0
        self.last_index = max(0, min(len(self.order) - 1, index + delta))
        self.selected = self.order[self.last_index]

    def say(self, text: str, tone: str = "") -> None:
        self.message, self.message_tone, self.message_at = text, tone, time.monotonic()

    # --- actions

    def open_selected(self) -> None:
        item = self.current()
        url = url_of(item) if item else ""
        if not url:
            self.say("no url for this port", DIM)
            return
        try:
            subprocess.Popen([opener(), url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            self.say(f"no browser opener found ({opener()})", GONE)
            return
        self.say(f"opened: {url}", FREE)

    def copy_selected(self) -> None:
        item = self.current()
        url = url_of(item) if item else ""
        if url and copy_to_clipboard(url):
            self.say(f"copied: {url}", FREE)
        else:
            self.say("nothing to copy" if not url else "no clipboard found", DIM)

    def follow_logs(self) -> None:
        item = self.current()
        command = logs_command(item, 200, True) if item else None
        if not command:
            self.say(f"does not write to a file: {output_of(item)}" if item else "", DIM)
            return
        terminal_write(MOUSE_OFF)
        curses.def_prog_mode()
        curses.endwin()
        print(f"\n\033[90m── {item.port} {label(item)} · ctrl-c takes you back ──\033[0m\n", flush=True)
        try:
            subprocess.run(command, check=False)
        except KeyboardInterrupt:
            pass  # ctrl-c is how you leave the logs
        curses.reset_prog_mode()
        terminal_write(MOUSE_ON)
        self.screen.clear()

    def ask(self, action: str, whole_group: bool) -> None:
        """Put a stop or restart question on the bottom line."""
        item, group = self.current(), self.current_group()
        if not item or not group:
            return
        with self.busy_lock:
            if self.busy:  # one at a time: two could act on the same port, and the first to end would hide the other
                self.say("still busy, one stop or restart at a time", DIM)
                return
        verb = "Stop" if action == "stop" else "Restart"
        if item.is_down and not whole_group:
            self.say(f"{item.port} {label(item)} is down: nothing runs to {action}", DIM)
            return
        if action == "restart" and not whole_group and not (item.container or item.restart):
            self.say(f"{item.port} cannot restart: {item.restart_problem or 'no restart plan'}", DIM)
            return
        if whole_group:
            branch = branch_text(group.branch, group.is_worktree)
            name = f"{group.title} {branch}".strip()
            running = [row for row in group.rows if not row.is_down]
            if not running:  # a filter can leave only down rows
                self.say(f"nothing runs in {name} to {action}", DIM)
                return
            self.confirm = (f"{verb} {plural(len(running), 'port', 'ports')} of {name}?", running, action)
        else:
            command = short_command(" ".join(item.restart.argv)) if item.restart else ""
            plan = f" with {command}" if command else ""
            self.confirm = (f"{verb} {item.port} {label(item)}{plan}?", [item], action)

    def run_in_background(self, action: str, targets: List[Listener]) -> None:
        names = " ".join(str(item.port) for item in targets)
        self.busy = f"stopping {names}" if action == "stop" else f"restarting {names}, waiting until it listens again"
        self.message = ""  # the spinner line shows only what is said while it runs

        def work() -> None:
            try:
                results = stop_many(targets) if action == "stop" else restart_many(targets)
                problems = [f"{port}: {problem}" for port, problem in results.items() if problem]
                if problems:
                    outcome = (("still taken, " if action == "stop" else "") + "; ".join(problems), GONE)
                else:
                    done = "free" if action == "stop" else "back up"
                    outcome = (f"{names} {'is' if len(targets) == 1 else 'are'} {done}", FREE)
            except Exception as error:  # the view stays up and says what went wrong
                outcome = (f"{action} failed: {error}", GONE)
            with self.busy_lock:  # ask refuses under it too, so its refusal never replaces this outcome
                self.say(*outcome)
                self.busy = ""
            self.scanner.refresh()

        threading.Thread(target=work, daemon=True).start()

    # --- keys

    def handle(self, key) -> bool:
        """Act on a key; False to leave."""
        if self.confirm:
            self.answer(key)
            return True
        if self.editing:
            return self.edit_filter(key)
        if self.showing_keys:
            self.showing_keys = key == "resize"  # any key closes the list and does nothing else
            return True
        if key == "q":
            return False
        if key == "esc":
            self.message = ""
            if self.filter:
                self.filter = ""
                self.rebuild()
        moves = {"up": -1, "down": 1, "pgup": -10, "pgdn": 10, "home": -10 ** 6, "end": 10 ** 6}
        actions = {"o": self.open_selected, "enter": self.open_selected, "l": self.follow_logs,
                   "c": self.copy_selected, "k": lambda: self.ask("stop", False), "K": lambda: self.ask("stop", True),
                   "r": lambda: self.ask("restart", False), "R": lambda: self.ask("restart", True)}
        if isinstance(key, tuple):
            self.mouse(key)
        elif key in moves:
            self.move(moves[key])
        elif key in actions:
            actions[key]()
        elif key == "/":
            self.editing = True
        elif key == "?":
            self.showing_keys = True
        elif key == "a":
            self.show_all = not self.show_all
            self.rebuild()
        return True

    def answer(self, key) -> None:
        """y says yes; n, esc and enter say no, as [y/N] does. Any other key, a
        resize or the mouse included, leaves the question open."""
        if key not in ("y", "Y", "n", "N", "esc", "enter"):
            return
        _, targets, action = self.confirm
        self.confirm = None
        if key in ("y", "Y"):
            self.run_in_background(action, targets)
        else:
            self.say("nothing stopped" if action == "stop" else "nothing restarted", DIM)

    def edit_filter(self, key) -> bool:
        if key == "enter":
            self.editing = False
        elif key == "esc":
            self.filter, self.editing = "", False
        elif key == "backspace":
            self.filter = self.filter[:-1]
        elif isinstance(key, str) and len(key) == 1 and key.isprintable():
            self.filter += key
        self.rebuild(from_top=True)
        return True

    def mouse(self, event: tuple) -> None:
        kind, value = event
        if kind == "wheel":
            self.move(value)
        elif value in self.row_at:
            self.selected = self.row_at[value]
            self.last_index = self.order.index(self.selected)

    # --- drawing

    def put(self, y: int, x: int, text: str, attr: int) -> int:
        """Write text clipped to the screen; the x after it."""
        width = self.screen.getmaxyx()[1] - 1
        if x >= width or not text:
            return x
        try:
            self.screen.addstr(y, x, text[: width - x], attr)
        except curses.error:
            pass  # curses refuses the bottom-right cell; the text before it is drawn
        return min(width, x + len(text))

    def put_segments(self, y: int, segments: List[Segment], styles: Dict[str, int], fill: bool = False) -> None:
        x = 0
        for text, tone in segments:
            x = self.put(y, x, text, styles[tone])
        if fill:
            self.put(y, x, " " * self.screen.getmaxyx()[1], styles[""])

    def detail_segments(self, item: Listener, width: int) -> List[List[Segment]]:
        url = url_of(item)
        lines = [[(" ", ""), (str(item.port), BOLD), ("  ", ""), (label(item), BOLD)]
                 + ([("  ", ""), (url, LINK)] if url else [])]
        fields = detail_fields(item, self.all_rows)
        key_w = max(len(key) for key, *_ in fields) + 2
        for key, value, tone, note in fields:
            lines.append([("   ", ""), (key.ljust(key_w), DIM), (value, tone)] + ([("  ", ""), (note, DIM)] if note else []))
        return lines

    def footer_segments(self, width: int) -> Tuple[List[Segment], bool]:
        """The bottom line, and whether it is an input line."""
        said = [(" " + self.message, self.message_tone)] if self.message and time.monotonic() - self.message_at < 6 else []
        if self.confirm:
            question = clip(self.confirm[0], width - 14)
            return [(" " + question, GONE), ("  y", BOLD), ("es / ", DIM), ("n", BOLD), ("o", DIM)], False
        if self.editing:
            return [(" / ", ACCENT), (self.filter, BOLD), ("▏", ACCENT),
                    ("   enter done · esc clears", DIM)], True
        if self.busy:
            frame = SPINNER[int(time.monotonic() * 8) % len(SPINNER)]
            busy = clip(self.busy, width - 6 - sum(len(text) for text, _ in said))
            return [(f" {frame} ", ACCENT), (busy, ""), ("  ", "")] + said, False
        if said:
            return said, False
        if self.showing_keys:
            return [(" any key closes this", DIM)], False
        group = self.current_group()
        possible = self.possible_keys()
        segments: List[Segment] = [(" ", "")]
        for key, what in self.KEYS:
            if key == "RK" and group and not group_stack(group):
                what = "project"
            if key in possible:
                segments += [(key, ACCENT), (f" {what}  ", DIM)]
        return segments, False

    def possible_keys(self) -> Set[str]:
        """The keys of the key row that do something for the selected row."""
        item, group = self.current(), self.current_group()
        if not item or not group:
            return {"?"}
        checks = {"↑↓": True, "o": bool(url_of(item)), "l": bool(item.container or item.log),
                  "r": bool(item.container or item.restart),
                  "k": not item.is_down and not is_docker_itself(item),
                  "RK": any(not row.is_down for row in group.rows), "?": True}
        return {key for key, on in checks.items() if on}

    def keys_lines(self) -> List[List[Segment]]:
        key_w = max(len(key) for key, _ in self.ALL_KEYS) + 3
        return [[("  ", ""), ("keys", BOLD)], []] + [
            [("    ", ""), (key.ljust(key_w), ACCENT), (what, "")] for key, what in self.ALL_KEYS]

    def title_segments(self, width: int) -> Tuple[List[Segment], List[Segment]]:
        left = [("  ", DIM)] + summary_segments(self.groups)
        right: List[Segment] = []
        if self.filter:
            right += [("/", ACCENT), (self.filter, BOLD), ("  ", "")]
        if self.show_all:
            right += [("all", WORKTREE), ("  ", "")]
        if self.error:
            right += [(self.error, GONE), ("  ", "")]
        elif self.scanned_at:
            ago = int(time.monotonic() - self.scanned_at)
            right += [("● live", FREE) if ago < 5 else (f"refreshed {ago}s ago", DIM), (" ", "")]
        return left, right

    def draw(self, styles: Styles) -> None:
        screen = self.screen
        height, width = screen.getmaxyx()
        screen.erase()
        if height < 10 or width < 50:
            self.put(0, 0, "portly live: make the window bigger", styles.normal[""])
            screen.refresh()
            return
        left, right = self.title_segments(width)
        x = self.put(0, 0, " portly ", styles.bar)
        for text, tone in left:
            x = self.put(0, x, text, styles.normal[tone])
        right_w = sum(len(text) for text, _ in right)
        x = max(x + 2, width - 1 - right_w)
        for text, tone in right:
            x = self.put(0, x, text, styles.normal[tone])
        if self.showing_keys:
            self.row_at = {}
            for offset, segments in enumerate(self.keys_lines()[: height - 3]):
                self.put_segments(2 + offset, segments, styles.normal)
            self.put_segments(height - 1, self.footer_segments(width)[0], styles.normal)
            screen.refresh()
            return

        item = self.current()
        detail = self.detail_segments(item, width) if item else []
        detail_h = min(len(detail) + 1, max(0, (height - 4) // 2)) if detail else 0
        top, bottom = 2, height - 1 - detail_h
        lines = group_lines(self.groups, width - 1)
        self.keep_visible(lines, bottom - top)
        self.row_at = {}
        if not lines:
            empty = f"Nothing found for {self.filter}." if self.filter else "Nothing is listening."
            self.put(top, 4, empty, styles.normal[DIM])
        for offset, (row, _, segments) in enumerate(lines[self.scroll: self.scroll + bottom - top]):
            y = top + offset
            chosen = row is not None and row.port == self.selected
            self.put_segments(y, segments, styles.selected if chosen else styles.normal, fill=chosen)
            if row is not None:
                self.row_at[y] = row.port
        above = sum(1 for row, _, _ in lines[: self.scroll] if row)
        below = sum(1 for row, _, _ in lines[self.scroll + bottom - top:] if row)
        if above:
            self.put(1, width - 12, f"↑ {above} more".rjust(10), styles.normal[DIM])
        if detail_h or below:
            rule = "─" * (width - 14) + (f" ↓ {below} more " if below else "─" * 12)
            self.put(bottom, 0, rule.ljust(width, "─"), styles.normal[DIM])
        if detail_h:
            for offset, segments in enumerate(detail[: detail_h - 1]):  # line bottom is the rule
                self.put_segments(bottom + 1 + offset, segments, styles.normal)

        footer, typing = self.footer_segments(width)
        self.put_segments(height - 1, footer, styles.normal)
        screen.refresh()

    def keep_visible(self, lines: List[Line], room: int) -> None:
        """Scroll so the selected row shows, with its group's header when it is the first row."""
        index = next((i for i, (row, _, _) in enumerate(lines) if row is not None and row.port == self.selected), None)
        if index is not None:
            first = index - 1 if index > 0 and lines[index - 1][0] is None and lines[index - 1][1] else index
            if first < self.scroll:
                self.scroll = first
            elif index >= self.scroll + room:
                self.scroll = index - room + 1
        self.scroll = max(0, min(self.scroll, max(0, len(lines) - room)))

    def run(self) -> None:
        try:
            curses.curs_set(0)
        except curses.error:
            pass  # a terminal without an invisible cursor shows it, no harm
        self.screen.keypad(False)
        keys = KeyReader(self.screen)
        styles = Styles()
        terminal_write(MOUSE_ON)
        try:
            while True:
                self.pull()
                self.draw(styles)
                key = keys.read()
                if key is not None and not self.handle(key):
                    return
        except KeyboardInterrupt:
            return
        finally:
            terminal_write(MOUSE_OFF)


HELP = """\
  portly                   interactive view of your dev servers per project
  portly list              the same list, printed once
  portly shop              only what belongs to shop (project, branch, folder, tool)
  portly 3000              one port in detail
  portly kill 3000 8000    stop what listens there
  portly kill wt1          stop everything of a project or stack (asks first)
  portly restart 3000      stop it and start it again the way it was started (also: restart wt1)
  portly open 3000/admin   open http://localhost:3000/admin in your browser (https for symfony)
  portly logs 3000         follow its output: docker logs, or the file it writes to
  portly free 3000         the first free port from 3000 on
  portly wait 3000         wait until something listens on 3000 (handy in scripts)
"""


def parser_for(command: str, description: str) -> argparse.ArgumentParser:
    return argparse.ArgumentParser(prog=f"portly {command}".strip(), description=description,
                                   epilog=HELP, formatter_class=argparse.RawDescriptionHelpFormatter)


def targets_of(parser: argparse.ArgumentParser, words: List[str]) -> Tuple[List[int], List[str]]:
    try:
        return split_targets(words)
    except argparse.ArgumentTypeError as error:
        parser.error(str(error))


def paint_for_stdout() -> Paint:
    return Paint(sys.stdout.isatty() and "NO_COLOR" not in os.environ)


KILL_FLAG = re.compile(r"-[a-z]*k[a-z]*")  # -k, also in a group such as -ak or -ky


def split_kill_groups(argv: List[str]) -> List[str]:
    """-ky as -k -y: the plain parser does not know kill's -y, so it cannot split that group itself."""
    words = []
    for word in argv:
        words += [f"-{letter}" for letter in word[1:]] if KILL_FLAG.fullmatch(word) else [word]
    return words


def cmd_show(argv: List[str]) -> int:
    parser = parser_for("", "Who listens on which port, per project. In a terminal portly opens "
                            "the interactive view; portly list prints.")
    parser.add_argument("targets", nargs="*", metavar="port|filter",
                        help="a port number shows that port in detail; a word filters by project")
    parser.add_argument("-a", "--all", action="store_true", help="apps and helper processes too")
    parser.add_argument("-k", "--kill", action="store_true", help="the same as portly kill")
    parser.add_argument("--json", action="store_true", help="as JSON, for scripts")
    argv = split_kill_groups(argv)
    args, rest = parser.parse_known_args(argv)
    if args.kill:  # the words this parser does not use, -y too, are portly kill's to check, in their order
        kept = set(args.targets + rest)
        return cmd_kill([word for word in argv if word in kept])
    if rest:
        parser.error(f"unrecognized arguments: {' '.join(rest)}")
    ports, terms = targets_of(parser, args.targets)
    rows = with_down_ports(one_per_port(read_listeners(deep=bool(ports))))
    if args.json:
        chosen = [item for item in rows if item.port in ports] if ports else visible(rows, terms, args.all)
        print(json.dumps([as_json(item, deep=bool(ports)) for item in chosen], indent=2, ensure_ascii=False))
        return 0
    if ports:
        return show_ports(ports, rows, paint_for_stdout())
    return show_list(rows, terms, args.all, paint_for_stdout())


def interactive() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def cmd_start(argv: List[str]) -> int:
    """Plain portly: the live view in a terminal; a port, --json or a pipe prints."""
    printing = {"-h", "--help", "--json", "--kill"}
    killing = any(KILL_FLAG.fullmatch(word) for word in argv)
    if not interactive() or printing & set(argv) or killing or any(word.isdigit() for word in argv):
        return cmd_show(argv)
    return cmd_live(argv)


def cmd_kill(argv: List[str]) -> int:
    parser = parser_for("kill", "Stop what listens on a port, or everything of a project or stack.")
    parser.add_argument("targets", nargs="+", metavar="port|project")
    parser.add_argument("-y", "--yes", action="store_true", help="stop a project without asking")
    args = parser.parse_args(argv)
    ports, terms = targets_of(parser, args.targets)
    return kill(one_per_port(read_listeners()), ports, terms, args.yes, paint_for_stdout())


def cmd_restart(argv: List[str]) -> int:
    parser = parser_for("restart", "Stop what listens on a port and start it again the way it was started.")
    parser.add_argument("targets", nargs="+", metavar="port|project")
    parser.add_argument("-y", "--yes", action="store_true", help="restart a project without asking")
    args = parser.parse_args(argv)
    ports, terms = targets_of(parser, args.targets)
    return restart(one_per_port(read_listeners(deep=True)), ports, terms, args.yes, paint_for_stdout())


def cmd_open(argv: List[str]) -> int:
    parser = parser_for("open", "Open a port in your browser.")
    parser.add_argument("targets", nargs="+", metavar="port[/path]")
    args = parser.parse_args(argv)
    paint, code = paint_for_stdout(), 0
    rows = {item.port: item for item in one_per_port(read_listeners())}
    print()
    for target in args.targets:
        match = re.fullmatch(r"(\d+)(/.*)?", target)
        if not match:
            parser.error(f"not a port: {target}")
        port = port_number(match.group(1))
        if port not in rows:
            print(f"  {paint(BOLD, str(port))} is not listening.")
            code = 1
            continue
        url = url_of(rows[port])
        if not url:
            print(f"  {paint(BOLD, str(port))} speaks no http.")
            code = 1
            continue
        url += match.group(2) or ""
        problem = open_in_browser(url)
        if problem:
            print(f"  {paint(BOLD, str(port))} {paint(GONE, problem)}: {paint.link(url)}")
            code = 1
            continue
        print(f"  {paint(BOLD, str(port))} opened: {paint.link(url)}")
    print()
    return code


def cmd_logs(argv: List[str]) -> int:
    parser = parser_for("logs", "Follow the output of what listens on a port.")
    parser.add_argument("port", type=port_number, metavar="port")
    parser.add_argument("-n", "--lines", type=int, default=100, help="how many lines back (100)")
    parser.add_argument("--no-follow", action="store_true", help="show the lines and stop")
    args = parser.parse_args(argv)
    paint = paint_for_stdout()
    item = next((row for row in with_down_ports(one_per_port(read_listeners(deep=True)))
                 if row.port == args.port), None)
    if not item:
        print(f"\n  {paint(BOLD, str(args.port))} is not listening.\n")
        return 1
    command = logs_command(item, args.lines, not args.no_follow)
    if not command:
        print(f"\n  {paint(BOLD, str(args.port))} {label(item)} does not write to a file: {output_of(item)}.\n")
        return 1
    stop_hint = "" if args.no_follow else " · ctrl-c stops"
    print(paint(DIM, f"── {args.port} {label(item)}{stop_hint} ──"), flush=True)
    os.execvp(command[0], command)
    return 0


def cmd_free(argv: List[str]) -> int:
    parser = parser_for("free", "Find free ports.")
    parser.add_argument("start", nargs="?", type=port_number, default=3000, metavar="from")
    parser.add_argument("-n", "--count", type=int, default=1, help="how many free ports (1)")
    args = parser.parse_args(argv)
    found = free_ports(args.start, args.count, listening_ports())
    if not sys.stdout.isatty():
        print("\n".join(map(str, found)))
    else:
        paint = paint_for_stdout()
        print("\n" + "\n".join(f"  {paint(BOLD, str(port))} is {paint(FREE, 'free')}." for port in found) + "\n")
    return 0 if len(found) == args.count else 1


def cmd_wait(argv: List[str]) -> int:
    parser = parser_for("wait", "Wait until something listens on a port.")
    parser.add_argument("ports", nargs="+", type=port_number, metavar="port")
    parser.add_argument("-t", "--timeout", type=float, default=60, help="seconds, 0 waits for ever (60)")
    args = parser.parse_args(argv)
    paint, tty = paint_for_stdout(), sys.stdout.isatty()

    def tick(waited: float, waiting: List[int]) -> None:
        frame = SPINNER[int(waited * 4) % len(SPINNER)]
        names = " ".join(map(str, waiting))
        print(f"\r  {paint(ACCENT, frame)} waiting for {paint(BOLD, names)}  {paint(DIM, f'{int(waited)}s')}\033[K",
              end="", flush=True)

    clear = "\r\033[K" if tty else ""
    try:
        ok, waited = wait_for_listen(args.ports, args.timeout, tick if tty else None)
    except KeyboardInterrupt:
        print()
        return 130
    except subprocess.TimeoutExpired:
        print(clear, end="", flush=True)  # main says which tool hung, without the spinner in front
        raise
    names = " ".join(map(str, args.ports))
    if not ok:
        print(f"{clear}  {paint(BOLD, names)} not listening after {int(waited)}s.")
        return 1
    print(f"{clear}  {paint(BOLD, names)} {paint(FREE, 'listening')}  {paint(DIM, f'after {waited:.1f}s')}")
    return 0


def cmd_live(argv: List[str]) -> int:
    parser = parser_for("live", "Interactive: pick a port, see it, open, follow, copy or stop it.")
    parser.add_argument("terms", nargs="*", metavar="filter")
    parser.add_argument("-a", "--all", action="store_true", help="apps and helper processes too")
    args = parser.parse_args(argv)
    if not interactive():
        print("portly live needs a terminal; portly list prints the list.", file=sys.stderr)
        return 2
    os.environ.setdefault("ESCDELAY", "25")  # esc reacts at once instead of after a second
    locale.setlocale(locale.LC_ALL, "")  # curses counts ─ … ● as one cell only under a UTF-8 locale
    scanner = Scanner()
    scanner.start()
    curses.wrapper(lambda screen: LiveView(screen, scanner, args.terms, args.all).run())
    return 0


COMMANDS = {"list": cmd_show, "ls": cmd_show, "kill": cmd_kill, "restart": cmd_restart, "open": cmd_open,
            "logs": cmd_logs, "free": cmd_free, "wait": cmd_wait, "live": cmd_live,
            # The Dutch names from its days as poort, so scripts and habits keep working.
            "lijst": cmd_show, "herstart": cmd_restart, "vrij": cmd_free, "wacht": cmd_wait}


def main(argv: Optional[List[str]] = None) -> int:
    argv = sys.argv[1:] if argv is None else list(argv)
    # run() reads a missing tool as no output, so without lsof nothing would seem to listen.
    if not shutil.which("lsof") and not {"-h", "--help"} & set(argv):
        print("portly needs lsof: install it, or add the folder it is in (often /usr/sbin) to PATH.",
              file=sys.stderr)
        return 2
    try:
        if argv and argv[0] in COMMANDS:
            return COMMANDS[argv[0]](argv[1:])
        return cmd_start(argv)
    except subprocess.TimeoutExpired as error:  # what listens is unknown then, never empty
        print(f"portly stopped: {error.cmd[0]} did not answer within {int(error.timeout)}s.", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
